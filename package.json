{
  "name": "card-losverd-es",
  "version": "0.0.0",
  "private": true,
  "description": "Digital membership card service (card.losverd.es) on Cloudflare Workers, D1 & R2.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "format": "prettier --write \"src/**/*.{ts,sql,json}\"",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy:prod": "wrangler deploy --env production"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.6.0",
    "@cloudflare/workers-types": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "jose": "^5.0.0",
    "node-forge": "^1.3.0",
    "fflate": "^0.8.0"
  }
}
